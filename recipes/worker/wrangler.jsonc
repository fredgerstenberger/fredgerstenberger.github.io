// Cloudflare config for the Recipe Box Worker.
// Lets Cloudflare deploy straight from this GitHub folder (Worker → Settings → Build),
// and connects Workers AI (the "AI" binding used for photo scanning) automatically.
{
  "name": "recipe-proxy",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "ai": { "binding": "AI" },
  // Sync storage: one small built-in database per recipe box (free plan: SQLite-backed Durable Objects).
  "durable_objects": {
    "bindings": [
      { "name": "SYNC", "class_name": "RecipeSync" },
      { "name": "CACHE", "class_name": "DataCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RecipeSync"] },
    { "tag": "v2", "new_sqlite_classes": ["DataCache"] }
  ],
  // Refresh official grocery prices monthly (BLS publishes mid-month): 14:17 UTC on the 18th.
  "triggers": { "crons": ["17 14 18 * *"] }
}
